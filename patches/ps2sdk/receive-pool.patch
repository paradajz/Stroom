--- a/iop/tcpip/tcpip-base/include/lwipopts.h
+++ b/iop/tcpip/tcpip-base/include/lwipopts.h
@@ -120,1 +120,21 @@
-#define PBUF_POOL_SIZE		32	//SP193: should be at least ((TCP_WND/PBUF_POOL_BUFSIZE)+1). But that is too small to handle simultaneous connections.
+/* Shared by audio, artwork and launcher sockets. Keep TCP_WND unchanged so
+ * additional pool capacity provides headroom without enlarging each window. */
+#define PBUF_POOL_SIZE          96
+
+/* Retain out-of-order TCP segments across audio/artwork connections. The
+ * upstream default of 16 was exhausted during captured audio recovery. */
+#define MEMP_NUM_TCP_SEG        64
+
+/* Six receiver clients, artwork and launcher TCP traffic need more than
+ * the default five PCBs. NETCONN follows TCP+UDP (24 instead of 9), leaving
+ * space for listeners, discovery and transient metadata POST connections. */
+#define MEMP_NUM_TCP_PCB        16
+
+/* DNS, DHCP, launcher command/logging and both audio UDP listeners share
+ * this pool. Four entries cannot accommodate the launcher plus the app. */
+#define MEMP_NUM_UDP_PCB        8
+
+
+/* Tell compatible senders which later ranges survived a missing segment,
+ * so they can recover multiple gaps without resending retained data. */
+#define LWIP_TCP_SACK_OUT       1
