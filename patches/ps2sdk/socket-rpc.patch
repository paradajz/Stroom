+int platform_socket_bridge_compatible(void)
+{
+    if (!_ps2ip.server)
+    {
+        return 0;
+    }
+
+    Ps2SocketBridgeInfo info = { 0 };
+    WaitSema(lock_sema);
+    /* Send zeros as well as clearing the reply: legacy handlers return their
+     * shared IOP buffer unchanged for unknown commands. */
+    memset(_rpc_buffer.buffer, 0, sizeof(info));
+    int result = sceSifCallRpc(&_ps2ip, PS2_SOCKET_RPC_INFO, 0,
+                              _rpc_buffer.buffer, sizeof(info),
+                              _rpc_buffer.buffer, sizeof(info), NULL, NULL);
+    if (result >= 0)
+    {
+        memcpy(&info, _rpc_buffer.buffer, sizeof(info));
+    }
+    SignalSema(lock_sema);
+
+    unsigned required = STROOM_DIAGNOSTICS ? PS2_SOCKET_CAP_DIAGNOSTICS : 0;
+    return result >= 0 && info.magic == PS2_SOCKET_BRIDGE_MAGIC &&
+           info.abi == PS2_SOCKET_BRIDGE_ABI &&
+           (info.capabilities & required) == required;
+}
+
+#if STROOM_DIAGNOSTICS
+void platform_net_driver_stats(Ps2NetDriverStats* stats)
+{
+    memset(stats, 0, sizeof(*stats));
+    stats->status = -2;
+    if (!_ps2ip.server)
+    {
+        return;
+    }
+    WaitSema(lock_sema);
+    memset(_rpc_buffer.buffer, 0, sizeof(Ps2NetDriverStats));
+    if (sceSifCallRpc(&_ps2ip, PS2_SOCKET_RPC_DRIVER_STATS, 0, NULL, 0,
+                      _rpc_buffer.buffer, sizeof(Ps2NetDriverStats), NULL, NULL) >= 0)
+    {
+        memcpy(stats, _rpc_buffer.buffer, sizeof(*stats));
+    }
+    SignalSema(lock_sema);
+}
+
+void platform_net_diagnostic(const Ps2DiagnosticRequest* request, Ps2DiagnosticReply* reply)
+{
+    memset(reply, 0, sizeof(*reply));
+    reply->status = -2;
+    if (!_ps2ip.server)
+    {
+        return;
+    }
+    Ps2DiagnosticRequest translated = *request;
+    if (request->command == DIAGNOSTIC_IOP_SELECT && request->socket >= 0)
+    {
+        translated.socket = ps2sdk_get_iop_fd(request->socket);
+        if (translated.socket < 0)
+        {
+            reply->status = -3;
+            return;
+        }
+    }
+    WaitSema(lock_sema);
+    memcpy(_rpc_buffer.buffer, &translated, sizeof(translated));
+    if (sceSifCallRpc(&_ps2ip, DIAGNOSTIC_IOP_RPC, 0, _rpc_buffer.buffer, sizeof(*request),
+                      _rpc_buffer.buffer, sizeof(*reply), NULL, NULL) >= 0)
+    {
+        memcpy(reply, _rpc_buffer.buffer, sizeof(*reply));
+    }
+    SignalSema(lock_sema);
+}
+
 #endif
