 ## Determine the maximum number of processes that Make can work with.
 ## Also make preparations for different toolchains
 SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
-FETCH="$SCRIPT_DIR/fetch.sh"
+# An empty list retains the upstream full build. Explicit lists must include
+# dependencies and use repository directory names (for example libpng).
+function selected {
+    [ -z "${PORTS_LIBRARIES:-}" ] && return 0
+
+    case " $PORTS_LIBRARIES " in
+        *" ${1%%/*} "*) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+function fetch_selected {
+    local name="${2##*/}"
+    selected "${name%.git}" || return 0
+    "$SCRIPT_DIR/fetch.sh" "$@"
+}
+
+FETCH=fetch_selected
 PROC_NR=$(getconf _NPROCESSORS_ONLN)
 CFLAGS=""
 XTRA_OPTS=""
